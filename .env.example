# ClickUp Personal API key
# Obtenela en: https://app.clickup.com/settings/apps
CLICKUP_API_KEY=tu_api_key_aqui

# Opcional: ubicación de la caché local (SQLite).
# Se crea sola, con sus directorios, la primera vez que usás sync_tasks.
# Default: ${XDG_DATA_HOME:-~/.local/share}/mcp-clickup-server/clickup.db
# CLICKUP_CACHE_DB=/ruta/a/clickup.db
